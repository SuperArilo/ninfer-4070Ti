diff --git a/.github/workflows/build-windows-sm89.yml b/.github/workflows/build-windows-sm89.yml
new file mode 100644
index 00000000..35095a59
--- /dev/null
+++ b/.github/workflows/build-windows-sm89.yml
@@ -0,0 +1,101 @@
+name: Windows Build (Ada sm_89)
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [ "master", "main", "ada-sm89" ]
+
+env:
+  VSLANG: "1033"
+
+jobs:
+  build:
+    runs-on: windows-latest
+
+    steps:
+    - uses: actions/checkout@v4
+
+    - name: Fetch vendored FFmpeg (BtbN win64 gpl shared)
+      shell: pwsh
+      run: |
+        curl.exe -fsSL -o ffmpeg.zip "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-win64-gpl-shared.zip"
+        if ($LASTEXITCODE -ne 0) { throw "ffmpeg download failed" }
+        Expand-Archive -Path ffmpeg.zip -DestinationPath ffmpeg_tmp -Force
+        Move-Item ffmpeg_tmp\ffmpeg-master-latest-win64-gpl-shared ffmpeg
+        Remove-Item ffmpeg.zip -Force
+        Remove-Item ffmpeg_tmp -Recurse -Force
+        Get-ChildItem ffmpeg\include | Select-Object -First 5 -ExpandProperty Name
+
+    - name: Setup CUDA 13.3 (NVIDIA redist archives)
+      shell: pwsh
+      run: |
+        $root = "C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.3"
+        New-Item -ItemType Directory -Force -Path $root | Out-Null
+        $pkgs = @(
+          "cuda_crt/windows-x86_64/cuda_crt-windows-x86_64-13.3.33-archive.zip",
+          "cuda_cudart/windows-x86_64/cuda_cudart-windows-x86_64-13.3.29-archive.zip",
+          "cuda_nvcc/windows-x86_64/cuda_nvcc-windows-x86_64-13.3.33-archive.zip",
+          "cuda_nvrtc/windows-x86_64/cuda_nvrtc-windows-x86_64-13.3.33-archive.zip",
+          "libcublas/windows-x86_64/libcublas-windows-x86_64-13.5.1.27-archive.zip",
+          "libnvvm/windows-x86_64/libnvvm-windows-x86_64-13.3.33-archive.zip",
+          "cuda_nvtx/windows-x86_64/cuda_nvtx-windows-x86_64-13.3.29-archive.zip",
+          "cuda_profiler_api/windows-x86_64/cuda_profiler_api-windows-x86_64-13.3.27-archive.zip",
+          "visual_studio_integration/windows-x86_64/visual_studio_integration-windows-x86_64-13.3.27-archive.zip",
+          "cccl/windows-x86_64/cccl-windows-x86_64-13.3.3.3.1-archive.zip"
+        )
+        $tmp = Join-Path $env:RUNNER_TEMP "cuda-redist"
+        New-Item -ItemType Directory -Force -Path $tmp | Out-Null
+        Push-Location $tmp
+        foreach ($p in $pkgs) {
+          $name = Split-Path $p -Leaf
+          curl.exe -fsSL -o $name "https://developer.download.nvidia.com/compute/cuda/redist/$p"
+          if ($LASTEXITCODE -ne 0 -or -not (Test-Path $name)) { throw "download failed: $p" }
+          $dst = Join-Path $tmp $name.Replace('.zip','')
+          Expand-Archive -Path $name -DestinationPath $dst -Force
+          $src = $dst
+          $sub = @(Get-ChildItem -Directory $dst)
+          if ($sub.Count -eq 1) { $src = $sub[0].FullName }
+          Copy-Item (Join-Path $src '*') $root -Recurse -Force
+        }
+        Pop-Location
+        "CUDA_PATH=$root" >> $env:GITHUB_ENV
+        "$root\bin" >> $env:GITHUB_PATH
+        Write-Host "CUDA root: $root"
+
+    - name: Setup MSVC
+      uses: ilammy/msvc-dev-cmd@v1
+
+    - name: Toolchain check
+      shell: pwsh
+      run: |
+        cmake --version
+        ninja --version
+        & "$env:CUDA_PATH\bin\nvcc.exe" --version
+
+    - name: Configure CMake
+      shell: pwsh
+      run: cmake -B build -S . -G Ninja -DCMAKE_CUDA_ARCHITECTURES=89 -DCMAKE_CUDA_COMPILER="$env:CUDA_PATH/bin/nvcc.exe" -DNINFER_BUILD_APPS=ON -DCMAKE_BUILD_TYPE=Release
+
+    - name: Build
+      shell: pwsh
+      run: cmake --build build --config Release -j 8 -- -k 0
+
+    - name: Stage binaries
+      if: always()
+      shell: pwsh
+      run: |
+        New-Item -ItemType Directory -Force -Path dist | Out-Null
+        foreach ($f in @("ninfer.exe","ninfer-serve.exe","ninfer-perplexity.exe")) {
+          if (Test-Path "build\apps\$f") { Copy-Item "build\apps\$f" dist\ }
+        }
+        Copy-Item ffmpeg\bin\avcodec-*.dll,ffmpeg\bin\avformat-*.dll,ffmpeg\bin\avutil-*.dll,ffmpeg\bin\swscale-*.dll,ffmpeg\bin\swresample-*.dll dist\ -ErrorAction SilentlyContinue
+        if (Test-Path start_4090.bat) { Copy-Item start_4090.bat dist\ }
+        Get-ChildItem dist | Select-Object Name, Length
+
+    - name: Upload binaries
+      if: always()
+      uses: actions/upload-artifact@v4
+      with:
+        name: ninfer-windows-sm89
+        if-no-files-found: warn
+        path: dist/
