+    pairs = (
+        ("hidden_size", text.get("hidden_size"), dflash2_summary.get("hidden_size")),
+        ("vocab_size", text.get("vocab_size"), dflash2_summary.get("vocab_size")),
+        (
+            "num_target_layers",
+            text.get("num_hidden_layers"),
+            dflash2_summary.get("num_target_layers"),
+        ),
+        (
