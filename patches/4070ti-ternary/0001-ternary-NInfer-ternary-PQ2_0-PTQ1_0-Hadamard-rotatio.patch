+    "OFFICIAL_EMBEDDING_SOURCE",
+    "OFFICIAL_RECIPES",
+    "OFFICIAL_RECIPES_BY_NAME",
+    "OFFICIAL_TENSOR_SPECS",
+    "QUANTIZED_DIRECT_BY_NAME",
+    "QUANTIZED_DIRECT_RECIPES",
