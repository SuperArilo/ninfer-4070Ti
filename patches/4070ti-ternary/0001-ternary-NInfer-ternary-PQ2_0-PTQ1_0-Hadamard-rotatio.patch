-                        (sequence.rewrite_state && handle == *sequence.rewrite_state);
-        for (const LongAnchorCheckpoint& anchor : sequence.long_anchors) {
-            repeated = repeated || anchor.state == handle;
-        }
-        if (!repeated && !validate_state(handle, true)) { return false; }
-    }
-    return true;
