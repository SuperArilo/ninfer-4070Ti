+DensePostMixerPayload load_mlp(const MlpPlan& plan,
+                               const artifact::MaterializedArtifact& materialized) {
+    DensePostMixerPayload out;
+    out.gate_up = materialized_weight(materialized, plan.gate_up, 34816, 5120);
