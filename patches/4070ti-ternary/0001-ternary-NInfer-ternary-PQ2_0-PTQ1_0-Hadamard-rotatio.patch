-        detail::PhysicalResources exact;
-        exact.device.backend_kv_pages = residual.device.backend_kv_pages;
-        endpoint(exact);
-        detail::PhysicalResources full;
-        full.device.backend_kv_pages = std::numeric_limits<std::uint32_t>::max();
