+    or spec.name.startswith("mtp/")
+    or spec.name.startswith("vision/")
+)
+OFFICIAL_RECIPES = tuple(
+    official_recipe.RECIPES_BY_NAME[spec.name]
+    for spec in OFFICIAL_TENSOR_SPECS
+)
+OFFICIAL_RECIPES_BY_NAME = {
