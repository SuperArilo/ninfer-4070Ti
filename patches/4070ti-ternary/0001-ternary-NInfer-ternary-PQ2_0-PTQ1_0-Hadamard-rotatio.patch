+        return 1;
+    }
+    (void)first_prompt;
+    if (second_ms > first_ms * 0.5 && second_ms > 8.0) {
+        std::cerr << "second prepare was not a suffix encode\n";
+        return 1;
+    }
+    return 0;
+}
