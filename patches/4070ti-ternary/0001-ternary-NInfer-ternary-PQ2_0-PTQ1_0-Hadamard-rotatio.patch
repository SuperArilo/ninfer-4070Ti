-    const std::string test_name = "test_is_" + test_id;
-    auto it                     = builtins.find(test_name);
-    if (it == builtins.end()) { throw std::runtime_error("Unknown test '" + test_id + "'"); }
-
-
-
-    auto res = it->second(args);
-
-    if (negate) {
-        return mk_val<value_bool>(!res->as_bool());
-    } else {
-        return res;
-    }
