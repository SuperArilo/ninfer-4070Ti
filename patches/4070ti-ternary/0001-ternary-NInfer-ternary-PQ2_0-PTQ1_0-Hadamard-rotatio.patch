-                                   .chat_template_kwargs_json = options.chat_template_kwargs_json,
-                                   .add_vision_id             = options.add_vision_id,
-                                   .tool_jsons                = options.tool_jsons};
-    rendered.cache_markers.assign(cache_markers.begin(), cache_markers.end());
-    return rendered;
-}
