+    if committed_prefill_tokens == request_done_prefill_tokens:
+        return None
+    if committed_prefill_tokens > request_done_prefill_tokens:
+        raise corpus.CampaignError(
+            "throughput and request_done prefill token totals differ"
+        )
+    if os.name != "nt":
+        raise corpus.CampaignError(
+            "throughput and request_done prefill token totals differ"
+        )
+    peaks = [
+        int(event["tokens"]["computed_prefill"])
+        for event in throughput_events
