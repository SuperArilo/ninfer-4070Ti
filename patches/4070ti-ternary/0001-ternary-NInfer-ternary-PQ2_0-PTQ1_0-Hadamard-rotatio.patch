+        derived = {
+            draft_head.DRAFT_HEAD_TOKEN_IDS_OBJECT: (
+                draft_head.materialize_draft_head_token_ids(draft)
+            )
+        }
+    return recipe.materialize_recipe(
+        recipes_by_name[spec.name],
