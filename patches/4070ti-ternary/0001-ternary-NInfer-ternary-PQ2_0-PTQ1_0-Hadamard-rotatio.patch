-                inspect_checkpoint_drop_option(sequence, dropped);
-            if (drop) {
-                append_unique(
-                    combine_checkpoint_and_replica_target(std::move(*drop), std::move(*replica)));
-            }
-        }
-    }
-    return successors;
-}
