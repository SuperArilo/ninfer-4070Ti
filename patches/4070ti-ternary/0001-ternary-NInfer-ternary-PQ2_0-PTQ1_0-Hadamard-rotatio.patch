+        const std::int64_t src1 = kv_cache_int8_quant_src_index<Geometry>(kv_head, d1, token);
+        k0                      = __bfloat162float(k[src0]);
+        k1                      = __bfloat162float(k[src1]);
+        v0                      = __bfloat162float(v[src0]);
+        v1                      = __bfloat162float(v[src1]);
