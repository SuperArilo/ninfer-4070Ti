+ProgramImplCore::~ProgramImplCore() noexcept {
+    if (device.transfer_stream != nullptr) { (void)cudaStreamSynchronize(device.transfer_stream); }
+    if (device.stream != nullptr) { (void)cudaStreamSynchronize(device.stream); }
+}
