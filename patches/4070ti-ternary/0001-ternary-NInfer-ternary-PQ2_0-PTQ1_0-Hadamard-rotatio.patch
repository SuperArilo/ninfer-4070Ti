-                pairs.push_back({std::move(key), parse_expression()});
-                if (is(token::comma)) ++current;
-            }
-            ++current;
-            return mk_stmt<object_literal>(start_pos, std::move(pairs));
-        }
-        default:
-            throw std::runtime_error("Unexpected token: " + t.value + " of type " +
-                                     std::to_string(t.t));
-        }
-    }
-};
