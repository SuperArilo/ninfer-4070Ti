-                if (entitlement < mapped ||
-                    entitlement - mapped >
-                        std::numeric_limits<std::uint32_t>::max() - device_pages) {
-                    throw std::logic_error("owner active KV entitlement is inconsistent");
-                }
-                device_pages += entitlement - mapped;
