+                const float weight1 = static_cast<float>(static_cast<int>((raw >> 2) & 3u) - 1);
+                const float weight2 = static_cast<float>(static_cast<int>((raw >> 4) & 3u) - 1);
+                const float weight3 = static_cast<float>(static_cast<int>((raw >> 6) & 3u) - 1);
