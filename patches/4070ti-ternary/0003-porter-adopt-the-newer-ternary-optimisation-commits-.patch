+    // and this CTA owns one contiguous row range, so a fixed token is a contiguous run.
+    constexpr int kRowsPerBlock = kGemvWarpsPerBlock * kR;
+    const int row_base          = static_cast<int>(blockIdx.x) * kRowsPerBlock;
